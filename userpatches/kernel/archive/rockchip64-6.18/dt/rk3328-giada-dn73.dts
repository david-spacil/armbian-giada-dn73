// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * Giada DN73 - fanless ARM digital signage player
 *
 * Rockchip RK3328 soldered directly on a Giada-designed board (ODM JieHe,
 * board marking JHS557). Not a SoM: the SoC, DDR3, eMMC, the RTL8211E
 * gigabit PHY and an RTL8821CU USB WiFi/BT combo all sit on one PCB.
 *
 * Derived from rk3328-dusun-dsom-010r.dts, which shares the SoC and the
 * RK805 power design. Board-specific values (PHY power/reset GPIOs, RGMII
 * delays, WiFi power GPIO) come from the vendor Android device tree
 * "GIADA JHS557 ANDROID Q".
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/pinctrl/rockchip.h>

#include "rk3328.dtsi"
#include "rk3328-dram-default-timing.dtsi"

/ {
	model = "Giada DN73";
	compatible = "giada,dn73", "rockchip,rk3328";

	aliases {
		ethernet0 = &gmac2io;
		mmc0 = &sdmmc;
		mmc2 = &emmc;
		/*
		 * The HYM8563 gets rtc0 so that userspace syncs the chip that
		 * actually has a backup cell. The RK805 keeps its own RTC and
		 * falls through to rtc1.
		 */
		rtc0 = &hym8563;
	};

	chosen {
		stdout-path = "serial2:1500000n8";
	};

	adc-keys {
		compatible = "adc-keys";
		io-channels = <&saradc 0>;
		io-channel-names = "buttons";
		keyup-threshold-microvolt = <1750000>;

		button-recovery {
			label = "Recovery";
			linux,code = <KEY_VENDOR>;
			press-threshold-microvolt = <10000>;
		};
	};

	gmac_clkin: external-gmac-clock {
		compatible = "fixed-clock";
		clock-frequency = <125000000>;
		clock-output-names = "gmac_clkin";
		#clock-cells = <0>;
	};

	vcc_sys: vcc-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
	};

	vdd_5v0: vdd_5v0 {
		compatible = "regulator-fixed";
		regulator-name = "vdd_5v0";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&vcc_sys>;
	};

	vdd_3v3: vdd_3v3 {
		compatible = "regulator-fixed";
		regulator-name = "vdd_3v3";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vcc_sys>;
	};

	vcc_sd: sdmmc-regulator {
		compatible = "regulator-fixed";
		gpio = <&gpio0 RK_PD6 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&sdmmc0m1_pin>;
		regulator-name = "vcc_sd";
		regulator-boot-on;
		vin-supply = <&vcc_io>;
	};

	/*
	 * USB VBUS enables. The Dusun SoM drives GPIO3_A5 and GPIO3_A7 for
	 * these; on this board those two pins are uart1 RTS and CTS, i.e. the
	 * DB9 RS232 port, and the real enables are elsewhere - GPIO0_A2 and
	 * GPIO2_C5 per the vendor device tree.
	 *
	 * All four USB connectors were measured to enumerate with both pins
	 * held low, so VBUS is not actually gated on this revision and these
	 * regulators change nothing by themselves. They are corrected anyway
	 * because the wrong pins did do damage: they took the serial port
	 * away.
	 */
	vcc_otg_5v: vcc-otg-5v-regulator {
		compatible = "regulator-fixed";
		gpio = <&gpio0 RK_PA2 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&usb_otg_drv>;
		enable-active-high;
		regulator-name = "vcc_otg_5v";
		vin-supply = <&vcc_sys>;
	};

	vcc_host_5v: vcc-host-5v-regulator {
		compatible = "regulator-fixed";
		gpio = <&gpio2 RK_PC5 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&usb_host_drv>;
		enable-active-high;
		regulator-always-on;
		regulator-name = "vcc_host_5v";
		vin-supply = <&vcc_sys>;
	};

	/*
	 * Supply of the RTL8211E. Unlike on the Dusun SoM this is not a
	 * permanently powered rail - it is switched by GPIO0_A0, which the
	 * vendor device tree exposes through a pinctrl group literally named
	 * "eth-power-gpio". Without it the PHY never starts: MDIO reads return
	 * all zeroes and the RJ45 link LEDs stay dark.
	 */
	vcc_phy: vcc-phy-regulator {
		compatible = "regulator-fixed";
		gpio = <&gpio0 RK_PA0 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&eth_power_en>;
		enable-active-high;
		regulator-name = "vcc_phy";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
		regulator-boot-on;
		vin-supply = <&vcc_io>;
	};

	/delete-node/ opp-table-0;

	cpu0_opp_table: opp_table0 {
		compatible = "operating-points-v2";
		opp-shared;

		opp-600000000 {
			opp-hz = /bits/ 64 <600000000>;
			opp-microvolt = <950000>;
			clock-latency-ns = <40000>;
			opp-suspend;
		};
		opp-816000000 {
			opp-hz = /bits/ 64 <816000000>;
			opp-microvolt = <1000000>;
			clock-latency-ns = <40000>;
		};
		opp-1008000000 {
			opp-hz = /bits/ 64 <1008000000>;
			opp-microvolt = <1100000>;
			clock-latency-ns = <40000>;
		};
		opp-1200000000 {
			opp-hz = /bits/ 64 <1200000000>;
			opp-microvolt = <1200000>;
			clock-latency-ns = <40000>;
		};
		opp-1296000000 {
			opp-hz = /bits/ 64 <1296000000>;
			opp-microvolt = <1275000>;
			clock-latency-ns = <40000>;
		};
	};

	analog_sound: analog-sound {
		compatible = "simple-audio-card";
		simple-audio-card,format = "i2s";
		simple-audio-card,mclk-fs = <256>;
		simple-audio-card,name = "ANALOG";
		status = "okay";

		simple-audio-card,cpu {
			sound-dai = <&i2s1>;
		};

		simple-audio-card,codec {
			sound-dai = <&codec>;
		};
	};

	hdmi_sound: hdmi-sound {
		compatible = "simple-audio-card";
		simple-audio-card,format = "i2s";
		simple-audio-card,mclk-fs = <128>;
		simple-audio-card,name = "HDMI";
		status = "okay";

		simple-audio-card,cpu {
			sound-dai = <&i2s0>;
		};

		simple-audio-card,codec {
			sound-dai = <&hdmi>;
		};
	};
};

&cpu0 {
	cpu-supply = <&vdd_arm>;
};

&cpu1 {
	cpu-supply = <&vdd_arm>;
};

&cpu2 {
	cpu-supply = <&vdd_arm>;
};

&cpu3 {
	cpu-supply = <&vdd_arm>;
};

&emmc {
	bus-width = <8>;
	cap-mmc-highspeed;
	mmc-ddr-1_8v;
	mmc-hs200-1_8v;
	non-removable;
	pinctrl-names = "default";
	pinctrl-0 = <&emmc_clk>, <&emmc_cmd>, <&emmc_bus8>;
	vmmc-supply = <&vcc_io>;
	vqmmc-supply = <&vcc18_emmc>;
	status = "okay";
};

/*
 * No SDIO device on this board - the WiFi/BT combo is USB attached. The SDIO
 * controller has to stay off anyway, because its pins overlap the RGMII group
 * used by gmac2io and it would claim them first.
 */
&sdio {
	status = "disabled";
};

&sdmmc {
	bus-width = <4>;
	cap-sd-highspeed;
	disable-wp;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc0_clk>, <&sdmmc0_cmd>, <&sdmmc0_dectn>, <&sdmmc0_bus4>;
	vmmc-supply = <&vcc_sd>;
	status = "okay";
};

/*
 * Gigabit MAC driving the external RTL8211E. The PHY must be listed as a
 * child of the mdio node: of_mdiobus_register() sets phy_mask = ~0, so once
 * an mdio node exists no bus scan happens at all and only PHYs described in
 * the device tree get registered. Leaving it out ends in "no phy found".
 */
&gmac2io {
	assigned-clocks = <&cru SCLK_MAC2IO>, <&cru SCLK_MAC2IO_EXT>;
	assigned-clock-parents = <&gmac_clkin>, <&gmac_clkin>;
	clock_in_out = "input";
	phy-handle = <&rtl8211e>;
	phy-mode = "rgmii";
	phy-supply = <&vcc_phy>;
	pinctrl-names = "default";
	pinctrl-0 = <&rgmiim1_pins>;
	snps,aal;
	snps,rxpbl = <0x4>;
	snps,txpbl = <0x4>;
	tx_delay = <0x26>;
	rx_delay = <0x11>;
	status = "okay";

	mdio {
		compatible = "snps,dwmac-mdio";
		#address-cells = <1>;
		#size-cells = <0>;

		/*
		 * Reset has to be actively driven high - nothing else holds
		 * this line, and the board pulls it down, keeping the PHY
		 * silent even when its supply is on.
		 */
		reset-gpios = <&gpio1 RK_PD0 GPIO_ACTIVE_LOW>;
		reset-delay-us = <20000>;
		reset-post-delay-us = <100000>;

		rtl8211e: ethernet-phy@1 {
			reg = <1>;
		};
	};
};

/* The internal 100M PHY is not wired to anything on this board. */
&gmac2phy {
	status = "disabled";
};

&gpio0 {
	gpio-line-names =
		/* GPIO0_A0 - A7 */
		"eth-power-en", "", "", "", "", "", "", "",
		/* GPIO0_B0 - B7 */
		"", "", "", "", "", "", "", "",
		/* GPIO0_C0 - C7 */
		"", "", "", "", "", "", "", "",
		/* GPIO0_D0 - D7 */
		"", "", "", "", "", "", "", "";
};

&gpio1 {
	gpio-line-names =
		/* GPIO1_A0 - A7 */
		"", "", "", "", "", "", "", "",
		/* GPIO1_B0 - B7 */
		"", "", "", "", "", "", "", "",
		/* GPIO1_C0 - C7 */
		"", "", "", "", "", "", "", "",
		/* GPIO1_D0 - D7 */
		"eth-phy-reset", "", "", "", "", "", "", "";
};

&gpio3 {
	gpio-line-names =
		/* GPIO3_A0 - A7 */
		"", "", "", "", "", "", "", "",
		/* GPIO3_B0 - B7 */
		"wifi-power-en", "", "", "", "", "", "", "",
		/* GPIO3_C0 - C7 */
		"", "", "", "", "", "", "", "",
		/* GPIO3_D0 - D7 */
		"", "", "", "", "", "", "", "";

	/*
	 * The onboard RTL8821CU hangs off the GL850G USB hub but has its own
	 * supply pin. The vendor drives it from a "wireless-wlan" node with a
	 * WIFI,poweren_gpio property - a Rockchip vendor-kernel binding that
	 * does not exist in mainline. Simply holding the line high is enough:
	 * both the wlan interface (rtw88_8821cu) and bluetooth (btusb) appear.
	 */
	wifi-power-hog {
		gpio-hog;
		gpios = <RK_PB0 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "wifi-power-en";
	};
};

&i2c1 {
	status = "okay";

	/*
	 * Battery-backed RTC, on the same bus as the PMIC. The Dusun profile
	 * has no idea it exists and leaves the machine relying on the RK805's
	 * RTC alone. The chip on the unit tested here came up with its
	 * voltage-low flag clear, so the cell is fitted and had kept the
	 * oscillator running.
	 *
	 * No interrupt is described on purpose. The vendor device tree points
	 * its irq_gpio at GPIO2_C4, but that pin does not move when the alarm
	 * fires: with AIE set and AF latched in the chip, a read of every GPIO
	 * bank's EXT_PORT register is unchanged. The INT output goes to the
	 * power circuitry rather than to the SoC, which is the only way the
	 * datasheet's "RTC: set up independently every day, a week as a cycle"
	 * can work - scheduled power-on has to act while the SoC is off.
	 *
	 * Declaring the interrupt anyway would expose an rtc wakealarm that
	 * accepts a time and then silently never fires.
	 */
	hym8563: rtc@51 {
		compatible = "haoyu,hym8563";
		reg = <0x51>;
		#clock-cells = <0>;
		clock-output-names = "hym8563_clkout";
	};

	rk805: pmic@18 {
		compatible = "rockchip,rk805";
		reg = <0x18>;
		interrupt-parent = <&gpio2>;
		interrupts = <6 IRQ_TYPE_LEVEL_LOW>;
		#clock-cells = <1>;
		clock-output-names = "xin32k", "rk805-clkout2";
		gpio-controller;
		#gpio-cells = <2>;
		pinctrl-names = "default";
		pinctrl-0 = <&pmic_int_l>, <&pmic_sleep_l>;
		rockchip,system-power-controller;
		wakeup-source;

		vcc1-supply = <&vcc_sys>;
		vcc2-supply = <&vcc_sys>;
		vcc3-supply = <&vcc_sys>;
		vcc4-supply = <&vcc_sys>;
		vcc5-supply = <&vcc_io>;
		vcc6-supply = <&vcc_sys>;

		regulators {
			vdd_logic: DCDC_REG1 {
				regulator-name = "vdd_log";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1100000>;
				regulator-max-microvolt = <1450000>;
				regulator-ramp-delay = <12500>;

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <1000000>;
				};
			};

			vdd_arm: DCDC_REG2 {
				regulator-name = "vdd_arm";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <712500>;
				regulator-max-microvolt = <1450000>;
				regulator-ramp-delay = <12500>;

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <950000>;
				};
			};

			vcc_ddr: DCDC_REG3 {
				regulator-name = "vcc_ddr";
				regulator-always-on;
				regulator-boot-on;

				regulator-state-mem {
					regulator-on-in-suspend;
				};
			};

			vcc_io: DCDC_REG4 {
				regulator-name = "vcc_io";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <3300000>;
				};
			};

			vcc_18: LDO_REG1 {
				regulator-name = "vcc_18";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <1800000>;
				};
			};

			vcc18_emmc: LDO_REG2 {
				regulator-name = "vcc18_emmc";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <1800000>;
				};
			};

			vdd_10: LDO_REG3 {
				regulator-name = "vdd_10";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1000000>;
				regulator-max-microvolt = <1000000>;

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <1000000>;
				};
			};
		};
	};
};

&i2s0 {
	status = "okay";
};

&i2s1 {
	status = "okay";
};

&codec {
	status = "okay";
	mute-gpios = <&grf_gpio 0 GPIO_ACTIVE_LOW>;
};

&io_domains {
	pmuio-supply = <&vcc_io>;
	vccio1-supply = <&vcc_io>;
	vccio2-supply = <&vcc18_emmc>;
	vccio3-supply = <&vcc_io>;
	vccio4-supply = <&vcc_18>;
	vccio5-supply = <&vcc_io>;
	vccio6-supply = <&vcc_io>;
	status = "okay";
};

&pinctrl {

	ethernet {
		eth_power_en: eth-power-en {
			rockchip,pins = <0 RK_PA0 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	pmic {
		pmic_int_l: pmic-int-l {
			rockchip,pins = <2 RK_PA6 RK_FUNC_GPIO &pcfg_pull_up>;
		};

		pmic_sleep_l: pmic-sleep-l {
			rockchip,pins = <2 RK_PD2 RK_FUNC_GPIO &pcfg_pull_down>;
		};
	};

	usb2 {
		usb_otg_drv: usb-otg-drv {
			rockchip,pins = <0 RK_PA2 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		usb_host_drv: usb-host-drv {
			rockchip,pins = <2 RK_PC5 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};

&saradc {
	vref-supply = <&vcc_18>;
	status = "okay";
};

&dmc {
	status = "disabled";
};

&hdmi {
	status = "okay";
};

&hdmiphy {
	status = "okay";
};

&display_subsystem {
	status = "okay";
};

&gpu {
	status = "okay";
	mali-supply = <&vdd_logic>;
};

&spdif {
	pinctrl-0 = <&spdifm0_tx>;
	status = "okay";
};

&spdif_out {
	status = "okay";
};

&spdif_sound {
	status = "okay";
};

&threshold {
	temperature = <80000>; /* millicelsius */
};

&target {
	temperature = <95000>; /* millicelsius */
};

&soc_crit {
	temperature = <100000>; /* millicelsius */
};

&tsadc {
	rockchip,hw-tshut-mode = <0>;
	rockchip,hw-tshut-polarity = <0>;
	status = "okay";
};

/*
 * uart0 stays off: its pins are part of the same RGMII group gmac2io needs,
 * and there is no UART peripheral on this board - bluetooth is USB.
 * The serial console is uart2.
 */
&uart0 {
	status = "disabled";
};

/*
 * The DB9 on the back panel. Full RS232 with hardware flow control:
 * GPIO3_A4/A6 are RXD/TXD, GPIO3_A5 is RTS and GPIO3_A7 is CTS. Exposed as
 * /dev/ttyS1.
 */
&uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart1_xfer>, <&uart1_cts>, <&uart1_rts>;
	status = "okay";
};

&uart2 {
	/delete-property/ dmas;
	/delete-property/ dma-names;

	status = "okay";
};

&u2phy {
	status = "okay";
};

&u2phy_host {
	status = "okay";
};

&u2phy_otg {
	status = "okay";
};

&usb20_otg {
	dr_mode = "host";
	resets = <&cru SRST_USB2OTG>;
	reset-names = "dwc2";
	vbus-supply = <&vcc_otg_5v>;
	status = "okay";
};

&usb_host0_ehci {
	#address-cells = <1>;
	#size-cells = <0>;
	resets = <&cru SRST_USB2HOST_EHCIPHY>;
	reset-names = "ehci";
	status = "okay";
};

&usb_host0_ohci {
	status = "okay";
};

&usbdrd3 {
	#address-cells = <1>;
	#size-cells = <0>;
	dr_mode = "host";
	status = "okay";
};

&vop {
	status = "okay";
};

&vop_mmu {
	status = "okay";
};

&vpu {
	status = "okay";
	vcodec-supply = <&vdd_logic>;
};

&vpu_mmu {
	status = "okay";
};

&vepu_mmu {
	status = "okay";
};

&h265e_mmu {
	status = "okay";
};
